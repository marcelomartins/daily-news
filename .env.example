# Exemplo de arquivo .env para produção
# Copie para .env e ajuste os valores conforme necessário

# Ambiente
NODE_ENV=production

# Configuração do servidor
# HOST=0.0.0.0
# PORT=3000

# Configurações específicas da aplicação (se houver)
# RSS_UPDATE_INTERVAL=300000
# LOG_LEVEL=info

# Controle de jobs em background (RSS + plugin de headlines)
# DAILY_NEWS_BACKGROUND_JOBS=true
# DAILY_NEWS_BACKGROUND_JOBS_LOCK_STALE_MS=21600000
# DAILY_NEWS_FEEDS_WATCHER=true

# RSS fetch resiliente
# RSS_FETCH_TIMEOUT_MS=15000
# RSS_FETCH_MAX_RETRIES=2
# RSS_FETCH_RETRY_DELAY_MS=1000
# RSS_FETCH_CONCURRENCY=6

# Cache de plugins (fallback para RSS ao expirar)
# PLUGIN_CACHE_TTL_MINUTES=240

# Scraper: por padrão recusa navegar para localhost, redes privadas (RFC1918),
# link-local/metadata (169.254.x.x) e hostnames .local/.internal, porque as URLs
# vêm de páginas de terceiros e do LLM. Habilite apenas se você intencionalmente
# acompanha um site na sua própria rede.
# SCRAPER_ALLOW_PRIVATE_HOSTS=false

# Headlines Plugin (opcional - habilita extração de headlines via LLM)
# Funciona com qualquer provedor compatível com a API da OpenAI.
# AI_API_KEY=...
# HEADLINES_AI_API_KEY=...           # chave dedicada só para o plugin de headlines
# AI_MODEL=qwen/qwen3-next-80b-a3b-instruct
# AI_FALLBACK_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,z-ai/glm-4.5-air:free
# AI_MAX_RETRIES=2
# AI_RETRY_DELAY_MS=1500
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=4096   # teto de saída; a Cloudflare usa 256 quando omitido, o que trunca o JSON das headlines
# AI_EXTRA_HEADERS={"HTTP-Referer":"https://daily-news.local","X-Title":"Daily News Aggregator"}

# Provedor de IA - escolha UMA das opções abaixo (AI_BASE_URL aceita a base ou o endpoint completo)

# Opção 1: OpenRouter (padrão - se AI_BASE_URL for omitido, é este que será usado)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-oss-20b

# Opção 2: Cloudflare Workers AI
# AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/SEU_ACCOUNT_ID/ai/v1
# AI_API_KEY=SEU_CLOUDFLARE_API_TOKEN
# AI_MODEL=@cf/openai/gpt-oss-20b

# Opção 3: Cloudflare AI Gateway (cache, rate limit e logs; troca de provedor sem mexer no código)
# AI_BASE_URL=https://gateway.ai.cloudflare.com/v1/SEU_ACCOUNT_ID/SEU_GATEWAY/compat
# AI_API_KEY=SEU_CLOUDFLARE_API_TOKEN
# AI_MODEL=workers-ai/@cf/openai/gpt-oss-20b

# HEADLINES_INTERVAL_MINUTES=120
# TRANSLATION_TARGET_LANG=pt-BR # Leave empty or commented to disable translation and keep original language

# Compatibilidade: as variáveis antigas OPENROUTER_* / HEADLINES_OPENROUTER_API_KEY
# continuam sendo lidas como fallback, mas estão depreciadas. Prefira as AI_*.
